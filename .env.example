# Contoh konfigurasi. Salin menjadi `.env`, lalu isi nilainya.
# Jangan commit `.env`.

# development | production
APP_ENV=development

# Wajib di produksi. Minimal 32 karakter acak.
# Contoh membuat: bun -e "console.log(crypto.randomUUID() + crypto.randomUUID())"
SECRET_KEY=

# Lokasi basis data SQLite.
KONTER_DB=konter.sqlite

# Alamat server.
PORT=3000
HOST=127.0.0.1

# 1 = cookie sesi hanya dikirim lewat HTTPS. Untuk LAN HTTP set 0.
COOKIE_SECURE=0

# 1 hanya bila aplikasi berada di belakang reverse proxy tepercaya.
TRUST_PROXY=0
